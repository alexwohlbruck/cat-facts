### Core
# Base URL for OAuth callback + any absolute links the app builds
BASE_URL=http://localhost:3000

# MongoDB Atlas settings (used to build mongodb+srv URL)
DB_HOST=your-cluster.mongodb.net
DB_NAME=cat-facts
DB_USERNAME=
DB_PASSWORD=

### Security / sessions
SESSION_SECRET=
ENCRYPTION_ALGORITHM=aes-256-ctr
ENCRYPTION_KEY=
GENERAL_ACCESS_TOKEN=

### Integrations (optional depending on what you use)
# Catbot/Dialogflow is optional. If unset, `/catbot/*` routes return 503 (except `/catbot/daily`).
APIAI_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IFTTT_API_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

### Docker / reverse proxy behavior
# If you're behind a TLS-terminating reverse proxy that sets x-forwarded-proto=https, you can set this to true.
FORCE_HTTPS_REDIRECT=false
